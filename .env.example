# Copy to .env and adjust. Every variable is optional locally; the defaults in
# src/config.ts match this file.
DATABASE_URL=postgres://curved:curved@127.0.0.1:55432/curved
TEST_DATABASE_URL=postgres://curved:curved@127.0.0.1:55432/curved_test
PORT=4747
# Required before the HTTP server will start (LAS-148).
CURVED_UI_TOKEN=
# Required before the GitHub webhook will accept deliveries (LAS-151).
GITHUB_WEBHOOK_SECRET=
# Token for the agent CLI; printed once by `agent add <name>`.
# CURVED_AGENT_TOKEN=
# Opt-in HTTPS session cookie: when on, login/logout Set-Cookie responses add
# the `Secure` attribute. Defaults off; enable only behind HTTPS.
# COOKIE_SECURE=1
# Passkey (WebAuthn) overrides. By default origins are
# http://localhost:4747 and http://localhost:5173 with RP ID "localhost".
# CURVED_WEBAUTHN_ORIGINS takes comma-separated origins; the RP ID defaults to
# the hostname of the first origin and must equal or be a suffix of every host.
# CURVED_WEBAUTHN_ORIGINS=https://curved.example.com
# CURVED_WEBAUTHN_RP_ID=example.com
