{
  "name": "curved",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Lightweight, agent-first issue tracker with the rules enforced in code and in Postgres.",
  "engines": {
    "node": ">=26.2.0"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.server.json && tsc -p tsconfig.web.json",
    "test": "node --test --test-concurrency=1 test/*.test.ts",
    "check:arch": "node scripts/check-architecture.mjs",
    "check": "npm run typecheck && npm run check:arch && npm test",
    "build": "npm run typecheck && npm run build:web",
    "db": "bash scripts/db.sh",
    "acceptance": "bash scripts/acceptance.sh",
    "smoke:container": "bash scripts/container-smoke.sh",
    "smoke:compose": "bash scripts/compose-smoke.sh",
    "smoke:provision": "bash scripts/provision-smoke.sh",
    "smoke:release": "bash scripts/release-smoke.sh",
    "smoke:webhook": "bash scripts/webhook-smoke.sh",
    "smoke:webhook:live": "bash scripts/webhook-live.sh",
    "smoke:backup": "bash scripts/backup-smoke.sh",
    "smoke:agent": "bash scripts/agent-smoke.sh",
    "migrate": "node src/composition/migrate.ts",
    "start": "node src/composition/server.ts",
    "cli": "node src/composition/cli.ts",
    "mcp": "node src/composition/mcp.ts",
    "dev": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts"
  },
  "dependencies": {
    "@fontsource-variable/instrument-sans": "^5.3.0",
    "@fontsource-variable/jetbrains-mono": "^5.3.0",
    "@modelcontextprotocol/server": "^2.4.0",
    "@phosphor-icons/react": "^2.1.10",
    "@simplewebauthn/browser": "^14.0.0",
    "@simplewebauthn/server": "^14.1.0",
    "motion": "^14.14.0",
    "pg": "^8.13.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.4.0",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^24.0.0",
    "@types/pg": "^8.11.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "tailwindcss": "^4.3.5",
    "typescript": "^5.9.0",
    "vite": "^8.3.8"
  }
}
