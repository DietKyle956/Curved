# One site, served over HTTPS from the start.
#
# `tls internal` issues a certificate from Caddy's local CA; export it with
# `docker compose -f deploy/docker-compose.yml exec caddy cat /data/caddy/pki/authorities/local/root.crt`
# and trust it locally. Setting ACME_EMAIL switches to an ACME certificate for
# the public name instead; compose maps an empty value to "internal".
#
# HSTS is sent only when CURVED_HSTS_MAX_AGE is set to a number of seconds.
# Server-sent events are proxied unbuffered so frames reach the browser
# immediately. Caddy's automatic HTTPS redirects port 80 to this HTTPS site.
{$CURVED_DOMAIN:localhost} {
	tls {$ACME_EMAIL:internal}

	@hsts expression {env.CURVED_HSTS_MAX_AGE} != ""
	header @hsts Strict-Transport-Security "max-age={env.CURVED_HSTS_MAX_AGE}"

	# An encoder can buffer small SSE frames, so skip compression there.
	@compression not path /api/events
	encode @compression zstd gzip

	@sse path /api/events
	handle @sse {
		reverse_proxy app:4747 {
			flush_interval -1
		}
	}

	handle {
		reverse_proxy app:4747
	}
}
