# Production stack environment.
#
#   cp deploy/.env.example deploy/.env
#   chmod 600 deploy/.env
#
# Then replace every placeholder below. deploy/.env is gitignored; it supplies
# both Compose interpolation and the container environment.

# Postgres credentials. DATABASE_URL is built from these; use URL-safe values.
POSTGRES_USER=curved
POSTGRES_PASSWORD=change-me
POSTGRES_DB=curved

# Required before the app will start and the GitHub webhook will accept
# deliveries. Generate with e.g. `openssl rand -hex 32`.
CURVED_UI_TOKEN=change-me
GITHUB_WEBHOOK_SECRET=change-me

# Hostname Caddy serves. Keep localhost for a local TLS deployment. For public
# use this must be the DNS-only public name that points at the server's
# reserved IPv4 address, so the ACME HTTP challenge can reach port 80.
CURVED_DOMAIN=localhost

# Empty uses Caddy's internal CA (trust the exported root certificate).
# Set to a real email address to request a Let's Encrypt certificate instead;
# the name in CURVED_DOMAIN must be publicly resolvable for that to succeed.
ACME_EMAIL=

# HSTS max-age in seconds. Empty sends no Strict-Transport-Security header,
# which is what you want locally. Public deployments should set 31536000.
CURVED_HSTS_MAX_AGE=

# Adds the Secure attribute to session cookies. Keep enabled behind HTTPS.
COOKIE_SECURE=1

# Optional overrides.
# CURVED_DB_PORT=55432
# CURVED_HTTP_PORT=80
# CURVED_HTTPS_PORT=443
# CURVED_IMAGE=curved:latest

# Backup base directory for deploy/backup.sh and deploy/restore.sh. Unset means
# /srv/curved/backups, which bootstrap creates as deploy:deploy mode 0700; the
# scripts create it at mode 0700 when it is absent. curved-backup.service sets
# its own value in the unit, so this key moves manual and release sets only.
# Compose does not read it.
# CURVED_BACKUP_DIR=/srv/curved/backups
